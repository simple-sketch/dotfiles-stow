# Downloaded and managed automatically by vim-plug.
/vim/.vim/autoload/plug.vim
/vim/.vim/plugged/

# Generated Vim state. These files are not configuration and may contain
# local file paths or recoverable buffer contents.
/vim/.vim/.netrwhist
/vim/.vim/backup/
/vim/.vim/swp/
/vim/.vim/undo/
/vim/.vim/view/
/vim/.viminfo

# Downloaded Yazi plugins; restore with `ya pkg install`.
/yazi/.config/yazi/plugins/

# Generated Thunar keyboard shortcuts.
/thunar/.config/Thunar/accels.scm

# Generated Newsboat article cache and SQLite runtime files.
/newsboat/.newsboat/cache.db
/newsboat/.newsboat/cache.db.lock
/newsboat/.newsboat/cache.db-shm
/newsboat/.newsboat/cache.db-wal
