#!/usr/bin/env python3
"""Recover WirePlumber crashes; exit with the originating PipeWire core (Linux)."""
import fcntl
import os
from pathlib import Path
import re
import signal
import stat
import subprocess
import sys
import time

STOP = False


def request_stop(_signum, _frame):
    global STOP
    STOP = True


def process_identity(pid):
    """Include start time to reject PID reuse; require a same-user PipeWire."""
    try:
        proc = Path('/proc') / str(pid)
        if proc.stat().st_uid != os.getuid():
            return None
        data = (proc / 'stat').read_text()
        name, fields = data.split('(', 1)[1].rsplit(')', 1)
        fields = fields.split()
        if name != 'pipewire' or fields[0] in ('Z', 'X'):
            return None
        return pid, fields[19]  # /proc/PID/stat field 22: starttime
    except (OSError, ValueError, IndexError):
        return None


def acquire_lock(runtime):
    """Use a private runtime directory and never follow a lock-file symlink."""
    directory = os.lstat(runtime)
    if (not stat.S_ISDIR(directory.st_mode) or directory.st_uid != os.getuid()
            or stat.S_IMODE(directory.st_mode) & 0o077):
        raise ValueError('XDG_RUNTIME_DIR must be a private, same-user directory')
    directory_fd = os.open(runtime, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        fd = os.open('wireplumber-supervisor.lock',
                     os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW | os.O_NONBLOCK,
                     0o600, dir_fd=directory_fd)
    finally:
        os.close(directory_fd)
    try:
        info = os.fstat(fd)
        if (not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid()
                or info.st_nlink != 1 or stat.S_IMODE(info.st_mode) & 0o077):
            raise ValueError('unsafe WirePlumber lock file')
        # Allow the previous core's supervisor to notice shutdown and release it.
        deadline = time.monotonic() + 8
        while not STOP:
            try:
                fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                return fd
            except BlockingIOError:
                if time.monotonic() >= deadline:
                    break
                time.sleep(0.1)
    except BaseException:
        os.close(fd)
        raise
    os.close(fd)
    return None


def find_core():
    # context.exec detaches children, so PPID is not a reliable core PID.
    deadline = time.monotonic() + 10
    while not STOP and time.monotonic() < deadline:
        try:
            result = subprocess.run(['pw-cli', 'info', '0'], capture_output=True,
                                    text=True, timeout=1, check=False)
            match = re.search(r'application\.process\.id\s*=\s*"([0-9]+)"',
                              result.stdout)
            if result.returncode == 0 and match:
                identity = process_identity(int(match[1]))
                if identity:
                    return identity
        except subprocess.TimeoutExpired:
            pass
        time.sleep(0.1)
    raise RuntimeError('could not identify the PipeWire core')


def stop_child(child):
    if child.poll() is None:
        child.terminate()
        try:
            child.wait(timeout=3)
        except subprocess.TimeoutExpired:
            child.kill()
            child.wait()


def supervise(core):
    delay = 2
    while not STOP and process_identity(core[0]) == core:
        started = time.monotonic()
        child = subprocess.Popen(['wireplumber'], close_fds=True)
        try:
            while (not STOP and process_identity(core[0]) == core
                   and child.poll() is None):
                time.sleep(0.2)
        finally:
            stop_child(child)
        if STOP or process_identity(core[0]) != core:
            break
        if time.monotonic() - started >= 60:
            delay = 2
        print(f'WirePlumber exited ({child.returncode}); retry in {delay}s',
              file=sys.stderr, flush=True)
        deadline = time.monotonic() + delay
        while (not STOP and process_identity(core[0]) == core
               and time.monotonic() < deadline):
            time.sleep(0.2)
        delay = min(delay * 2, 30)


def main():
    for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        signal.signal(sig, request_stop)
    runtime = os.environ.get('XDG_RUNTIME_DIR')
    if not runtime or not os.path.isabs(runtime) or os.getuid() == 0:
        raise ValueError('run as a desktop user with an absolute XDG_RUNTIME_DIR')
    lock = acquire_lock(runtime)
    if lock is None:
        return
    try:
        supervise(find_core())
    finally:
        os.close(lock)


if __name__ == '__main__':
    try:
        main()
    except (OSError, ValueError, RuntimeError) as error:
        print(f'wireplumber-supervisor: {error}', file=sys.stderr)
        sys.exit(1)
