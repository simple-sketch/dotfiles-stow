### Variables

# Super key (Mod1 = Alt).
set $mod Mod4
# Vim-style directions.
set $left h
set $down j
set $up k
set $right l

# Floating-window size (% of current workspace).
set $floating_width 45
set $floating_height 55

# Match the GTK/XWayland cursor.
seat * xcursor_theme Bibata-Modern-Ice 24

# Export session variables and initialize the keyring unlocked by PAM before Noctalia.
exec "dbus-update-activation-environment DISPLAY WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP XDG_SESSION_TYPE XDG_SESSION_DESKTOP QT_QPA_PLATFORM; gnome-keyring-daemon --start --components=secrets; exec noctalia"

# Start audio once; the helper stops it when Sway exits or its IPC disconnects.
# Use exec, not exec_always, so config reloads leave audio alone.
# Keep the lock for the helper's lifetime; do not pass its fd to audio children.
exec "exec flock --nonblock --close $XDG_RUNTIME_DIR/sway-audio.lock $HOME/.config/sway/scripts/start-audio.sh"

# Preload Kitty at login and on reload so even the first shortcut is fast.
# The lock prevents duplicate hidden windows; waiting keeps it held even when
# the preload joins a Kitty instance that was opened before the reload.
exec_always "exec flock --nonblock --close $XDG_RUNTIME_DIR/kitty-sway-server.lock kitty --single-instance --instance-group=sway-shortcuts --wait-for-single-instance-window-close --start-as=hidden /usr/bin/sleep infinity >>$HOME/.local/state/kitty-sway-server.log 2>&1"

# Pointer focus: yes, no, or always.
focus_follows_mouse yes

# Honor cross-workspace application focus requests.
focus_on_window_activation focus

# Inspect Wayland app IDs and XWayland properties:
# swaymsg -r -t get_tree | jq '.. | objects | select(.app_id != null or .window != null) | {name, app_id, shell, window_properties}'

# Size and center app-created floating windows.
for_window [floating] resize set width $floating_width ppt height $floating_height ppt, move position center

# Float selected Wayland apps; include geometry because criteria are not re-run.
for_window [app_id="^flameshot$"] floating enable, resize set width $floating_width ppt height $floating_height ppt, move position center
for_window [app_id="^com[.]gabm[.]satty$"] floating enable, resize set width $floating_width ppt height $floating_height ppt, move position center
for_window [app_id="^dev[.]noctalia[.]Noctalia$"] floating enable, resize set width $floating_width ppt height $floating_height ppt, move position center
for_window [app_id="(?i)^thunar$"] floating enable, resize set width $floating_width ppt height $floating_height ppt, move position center
for_window [app_id="(?i)^engrampa$"] floating enable, resize set width $floating_width ppt height $floating_height ppt, move position center
# Thunar's archive-plugin shim opens these GTK dialogs as separate windows.
for_window [title="^(Create Archive|Extract Archive To)$"] floating enable, resize set width $floating_width ppt height $floating_height ppt, move position center

# XWayland fallbacks; Noctalia has no observed class.
for_window [class="(?i)^(flameshot|satty|thunar|engrampa)$"] floating enable, resize set width $floating_width ppt height $floating_height ppt, move position center

# Sway already floats typed dialogs; the generic rule sizes them.
# Use roles only as a fallback for legacy X11 windows with incomplete hints.
for_window [window_role="(?i)^(about|organizer|preferences|bubble|page-info|pop-up|task_dialog|toolbox|webconsole)$"] floating enable, resize set width $floating_width ppt height $floating_height ppt, move position center

# Terminal.
set $term foot

# Launcher.
set $menu noctalia msg panel-toggle launcher

# Browser; keep in sync with BROWSER in ~/.bash_profile.
set $browser firefox

# Floating Kitty terminal; the distinct app ID keeps regular Kitty windows tiled.
set $floating_term kitty --single-instance --instance-group=sway-shortcuts --class kitty-floating
for_window [app_id="^kitty-floating$"] floating enable, resize set width $floating_width ppt height $floating_height ppt, move position center

# File manager.
set $file_manager thunar

# Editor.
set $text_editor neovide

# Neovide: workspace 2.
for_window [app_id="(?i)^neovide$"] move container to workspace number 2, workspace number 2

# Zed IDE: workspace 2.
for_window [app_id="(?i)^dev[.]zed[.]Zed$"] move container to workspace number 2, workspace number 2

# Swayimg: workspace 4; app config disables overlay mode.
for_window [app_id="^swayimg$"] move container to workspace number 4, workspace number 4

# VLC: workspace 5.
for_window [app_id="(?i)^vlc$"] move container to workspace number 5, workspace number 5

# Window switcher.
set $window_switcher_overview noctalia msg window-switcher

### Displays (Shikane)

# Start once: reloading Sway must preserve the selected display profile.
exec shikane
set $displays python3 ~/.config/sway/scripts/monitor-profiles.py
# Sway resets runtime output settings on reload; restore the last verified layout.
exec_always $displays reapply

# Portrait dual-screen; repeat to swap left and right.
bindsym --no-repeat $mod+Shift+v exec $displays toggle portrait

# External-only landscape.
bindsym --no-repeat $mod+Shift+b exec $displays switch docked

# Landscape dual-screen; repeat to swap left and right.
bindsym --no-repeat $mod+Shift+g exec $displays toggle extend

# Laptop only, including when an external monitor is still connected.
bindsym --no-repeat $mod+Shift+i exec $displays switch laptop

# Available profiles, with the current selection marked, in Noctalia.
bindsym --no-repeat $mod+p exec $displays pick

# Save the open-lid layout and workspaces, then restore them on reopening.
# Reload events are idempotent; closing without an external leaves suspend to the system.
bindswitch --locked --reload lid:on exec $displays lid closed
bindswitch --locked --reload lid:off exec $displays lid open

### Input

input type:touchpad {
    dwt enabled
    tap enabled
    natural_scroll enabled
    middle_emulation enabled
}

# US/LT layouts.
input "type:keyboard" {
    xkb_layout "us,lt"
}

# Super+\ cycles layouts through Noctalia.
bindsym --no-repeat --to-code $mod+backslash exec noctalia msg keyboard-layout-cycle

### Key bindings

# One-shot actions and toggles do not repeat while held. Navigation, movement,
# resizing, brightness, and volume adjustment intentionally remain repeatable.

# Basics
    # Close focused window.
    bindsym --no-repeat $mod+Shift+q kill

    # Right-click a title bar to close.
    bindsym button3 kill

    # Terminal.
    bindsym --no-repeat $mod+Return fullscreen disable; exec $term

    # Launcher.
    bindsym --no-repeat $mod+d exec $menu

    # Focus/launch on workspace 1; open another only when already focused there.
    # Keep placement in browser.sh so dragged-out tabs stay on their current workspace.
    set $browser_focus_or_new ~/.config/sway/scripts/browser.sh
    bindsym --no-repeat $mod+y fullscreen disable; exec $browser_focus_or_new $browser

    # Floating terminal.
    bindsym --no-repeat $mod+Shift+Return fullscreen disable; exec $floating_term

    # File manager.
    bindsym --no-repeat $mod+n fullscreen disable; exec $file_manager

    # Editor.
    bindsym --no-repeat $mod+t fullscreen disable; exec $text_editor

    # Window switcher.
    bindsym --no-repeat $mod+o exec $window_switcher_overview

    # Toggle Noctalia bars and reserved space.
    bindsym --no-repeat $mod+Control+c exec noctalia msg bar-toggle

    # Super+drag inside windows moves; Super+right-drag resizes (also tiled windows).
    floating_modifier $mod normal

    # Super+Shift+click on a Sway title bar: click 1–9 to send the window.
    include ~/.config/sway/workspace-selector.conf

    # Reload config.
    bindsym --no-repeat $mod+Shift+c reload

    # Open Noctalia's session panel.
    bindsym --no-repeat $mod+Shift+e exec noctalia msg panel-toggle session

    # Lock immediately without opening the session panel.
    bindsym --no-repeat $mod+Control+l exec noctalia msg session lock

# Focus and movement
    # Vim-style focus.
    bindsym $mod+$left focus left
    bindsym $mod+$down focus down
    bindsym $mod+$up focus up
    bindsym $mod+$right focus right
    # Arrow-key focus.
    bindsym $mod+Left focus left
    bindsym $mod+Down focus down
    bindsym $mod+Up focus up
    bindsym $mod+Right focus right

    # Super+scroll changes pane focus.
    bindsym --whole-window $mod+button4 focus prev sibling
    bindsym --whole-window $mod+button5 focus next sibling

    # Super+Shift+scroll changes workspace.
    bindsym --whole-window $mod+Shift+button4 workspace prev
    bindsym --whole-window $mod+Shift+button5 workspace next

    # Super+Shift+Vim key moves the focused window.
    bindsym $mod+Shift+$left move left
    bindsym $mod+Shift+$down move down
    bindsym $mod+Shift+$up move up
    bindsym $mod+Shift+$right move right
    # Super+Shift+arrow moves the focused window.
    bindsym $mod+Shift+Left move left
    bindsym $mod+Shift+Down move down
    bindsym $mod+Shift+Up move up
    bindsym $mod+Shift+Right move right

# Workspaces

    # Cycle active workspaces.
    bindsym $mod+Tab workspace next
    bindsym $mod+Shift+Tab workspace prev
    # Use physical number-row keys from the first layout (US), including in LT.
    # Switch workspace.
    bindsym --to-code $mod+1 workspace number 1
    bindsym --to-code $mod+2 workspace number 2
    bindsym --to-code $mod+3 workspace number 3
    bindsym --to-code $mod+4 workspace number 4
    bindsym --to-code $mod+5 workspace number 5
    bindsym --to-code $mod+6 workspace number 6
    bindsym --to-code $mod+7 workspace number 7
    bindsym --to-code $mod+8 workspace number 8
    bindsym --to-code $mod+9 workspace number 9
    bindsym --to-code $mod+0 workspace number 10
    # Move focused window to a workspace.
    bindsym --to-code $mod+Shift+1 move container to workspace number 1
    bindsym --to-code $mod+Shift+2 move container to workspace number 2
    bindsym --to-code $mod+Shift+3 move container to workspace number 3
    bindsym --to-code $mod+Shift+4 move container to workspace number 4
    bindsym --to-code $mod+Shift+5 move container to workspace number 5
    bindsym --to-code $mod+Shift+6 move container to workspace number 6
    bindsym --to-code $mod+Shift+7 move container to workspace number 7
    bindsym --to-code $mod+Shift+8 move container to workspace number 8
    bindsym --to-code $mod+Shift+9 move container to workspace number 9
    bindsym --to-code $mod+Shift+0 move container to workspace number 10

# Layouts
    # Horizontal or vertical split.
    bindsym $mod+b splith
    bindsym $mod+v splitv

    # Layout style.
    bindsym $mod+s layout stacking
    bindsym $mod+w layout tabbed
    bindsym --no-repeat $mod+e layout toggle split

    # Fullscreen.
    bindsym --no-repeat $mod+f fullscreen

    # Toggle floating.
    bindsym --no-repeat $mod+Shift+space floating toggle

    # Switch between tiled and floating focus.
    bindsym --no-repeat $mod+space focus mode_toggle

    # Focus parent.
    bindsym $mod+a focus parent
# Scratchpad

    # Stash the focused window; support standard and keypad minus.
    bindsym --no-repeat $mod+Shift+minus move scratchpad
    bindsym --no-repeat $mod+Shift+KP_Subtract move scratchpad

    # Show, hide, or cycle scratchpad windows.
    bindsym --no-repeat $mod+minus scratchpad show
    bindsym --no-repeat $mod+KP_Subtract scratchpad show

# Resize mode
mode "resize" {
    # Vim keys.
    bindsym $left resize shrink width 10px
    bindsym $down resize grow height 10px
    bindsym $up resize shrink height 10px
    bindsym $right resize grow width 10px

    # Arrow keys.
    bindsym Left resize shrink width 10px
    bindsym Down resize grow height 10px
    bindsym Up resize shrink height 10px
    bindsym Right resize grow width 10px

    # Exit resize mode.
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

# Media keys

# Brightness with Noctalia OSD.
bindsym --locked XF86MonBrightnessDown exec noctalia msg brightness-down
bindsym --locked XF86MonBrightnessUp exec noctalia msg brightness-up

# Volume with Noctalia OSD.
bindsym --locked --no-repeat XF86AudioMute exec noctalia msg volume-mute
bindsym --locked XF86AudioLowerVolume exec noctalia msg volume-down
bindsym --locked XF86AudioRaiseVolume exec noctalia msg volume-up
bindsym --locked --no-repeat XF86AudioMicMute exec noctalia msg mic-mute

# Playback through Noctalia's MPRIS service.
bindsym --locked --no-repeat XF86AudioPlay exec noctalia msg media toggle
bindsym --locked --no-repeat XF86AudioPause exec noctalia msg media toggle
bindsym --locked XF86AudioPrev exec noctalia msg media previous
bindsym --locked XF86AudioNext exec noctalia msg media next
bindsym --locked --no-repeat XF86AudioStop exec noctalia msg media stop

# Screenshots through Noctalia; the configured region capture opens Satty.
bindsym --no-repeat Print exec noctalia msg screenshot-region
bindsym --no-repeat Shift+Print exec noctalia msg screenshot-fullscreen
