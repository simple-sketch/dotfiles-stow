[
  {
    // Return to the active center pane from panels or any Vim mode.
    // Ctrl-1 already has built-in actions in several panels and views.
    "context": "Workspace",
    "bindings": {
      "ctrl-alt-1": "workspace::FocusCenterPane"
    }
  },
  {
    // Remove built-in Space bindings before defining leader sequences.
    // Keep this separate and earlier so it does not disable our sequences.
    "context": "(((Editor && mode == full && (vim_mode == normal || vim_mode == visual)) || EmptyPane) && !menu) || (ProjectPanel && not_editing)",
    "bindings": {
      "space": null
    }
  },
  {
    "context": "Editor && mode == full && (vim_mode == normal || vim_mode == visual) && !menu",
    "bindings": {
      // Find: retain the existing Vim package's ff / fg / fb vocabulary.
      "space f f": "file_finder::Toggle",
      "space f g": "pane::DeploySearch",
      "space f b": "tab_switcher::Toggle",
      "space f l": "buffer_search::Deploy",
      "space f s": "outline::Toggle",
      "space f shift-s": "project_symbols::Toggle",
      "space f p": "projects::OpenRecent",
      "space f e": "pane::RevealInProjectPanel",
      "space e": "project_panel::Toggle",
      "space r": "buffer_search::DeployReplace",

      // Code. LSP rename is separate from text replacement.
      "space c a": "editor::ToggleCodeActions",
      "space c r": "editor::Rename",
      "space c f": "editor::Format",
      "space c o": "editor::OrganizeImports",
      "space c s": "editor::ShowSignatureHelp",
      "space x x": "diagnostics::Deploy",

      // Markdown.
      "space m p": "markdown::OpenPreview",

      // Git: match Neovim's <leader>g vocabulary.
      "space g g": "git_panel::ToggleFocus",
      "space g d": "git::OpenFileDiff",
      "space g f": "git::FileHistory",
      "space g b": "git::Blame",
      "space g h p": "editor::ToggleSelectedDiffHunks",

      // Terminal and tasks.
      "space t t": "terminal_panel::Toggle",
      "space t r": "task::Spawn",
      "space t shift-r": "task::Rerun",

      // Save and split creation; tab/item closing lives under Space b.
      "space w w": "workspace::Save",
      "space w shift-w": "workspace::SaveAll",
      "space w v": "pane::SplitRight",
      "space w s": "pane::SplitDown",
      // Space f b uses the current pane's switcher; Space b b lists all panes.
      "space b b": "tab_switcher::ToggleAll",
      "space b d": "pane::CloseActiveItem",
      "space b o": "pane::CloseOtherItems",
      "space u i": "editor::ToggleInlayHints",
      "space u w": "editor::ToggleSoftWrap",
      "space u z": "workspace::ToggleZoom",
      "space ,": "zed::OpenSettingsFile",
      "space ?": "zed::OpenKeymap",

      // Keep built-in K for hover and Ctrl-O / Ctrl-I for navigation history.
      // Small Helix-inspired additions; use Vim-aware syntax selections.
      "space .": "vim::HelixJumpToWord",
      "alt-o": "vim::SelectLargerSyntaxNode",
      "alt-i": "vim::SelectSmallerSyntaxNode",
      "alt-j": "editor::MoveLineDown",
      "alt-k": "editor::MoveLineUp"
    }
  },
  {
    // Save in every full-editor mode; keep signature help available in Insert.
    "context": "Editor && mode == full && !menu",
    "bindings": {
      "ctrl-s": "workspace::Save",
      "ctrl-shift-space": "editor::ShowSignatureHelp"
    }
  },
  {
    // Reuse the Markdown preview chord to return to the source editor.
    "context": "MarkdownPreview && !menu",
    "bindings": {
      "space m p": "markdown::CloseAndReturnToEditor"
    }
  },
  {
    // Normal-only edits; Alt-J / Alt-K above also support Visual mode.
    "context": "Editor && mode == full && vim_mode == normal && !menu",
    "bindings": {
      "alt-shift-j": "editor::DuplicateLineDown",
      "alt-shift-k": "editor::DuplicateLineUp",
      "/": "buffer_search::Deploy",
      // [c / ]c navigate hunks. RestoreFile is intentionally not bound here:
      // the editor does not prompt; use the Git panel for whole-file discard.
      "space g h r": "git::Restore"
    }
  },
  {
    // In project-search results, use Vim's n instead of F3 for the next match.
    "context": "ProjectSearchView > Editor && vim_mode == normal && !menu",
    "bindings": {
      "n": "search::SelectNextMatch",
      "shift-n": "search::SelectPreviousMatch"
    }
  },
  {
    // Extra motions also work after operators: c Alt-E changes a subword.
    "context": "Editor && mode == full && VimControl && !menu",
    "bindings": {
      "alt-w": "vim::NextSubwordStart",
      "alt-b": "vim::PreviousSubwordStart",
      "alt-e": "vim::NextSubwordEnd"
    }
  },
  {
    "context": "Editor && mode == full && vim_mode == visual && !menu",
    "bindings": {
      "shift-s": "vim::PushAddSurrounds",
      "shift-x": "vim::Exchange",
      // Helix-style previous/next syntax sibling and one selection per line.
      "alt-p": "editor::SelectPreviousSyntaxNode",
      "alt-n": "editor::SelectNextSyntaxNode",
      "alt-s": ["editor::SplitSelectionIntoLines", { "keep_selections": true }]
    }
  },
  {
    // Make the essential pickers reachable after closing the last file.
    // not_editing keeps these out of project-panel rename/new-file inputs.
    "context": "(EmptyPane && !menu) || (ProjectPanel && not_editing)",
    "bindings": {
      "space f f": "file_finder::Toggle",
      "space f g": "pane::DeploySearch",
      "space f b": "tab_switcher::Toggle",
      "space f p": "projects::OpenRecent",
      "space b b": "tab_switcher::OpenInActivePane",
      "space e": "project_panel::Toggle"
    }
  },
  {
    // Zed's recommended Vim dock navigation; Terminal also covers terminals
    // opened in center panes. Press Ctrl-W, release, then H/J/K/L.
    // Native editor Ctrl-W bindings and plain Ctrl-H/J/K/L stay unchanged.
    // In terminals these chords take precedence over shell/TUI Ctrl-W input.
    "context": "Dock || Terminal",
    "bindings": {
      "ctrl-w h": "workspace::ActivatePaneLeft",
      "ctrl-w j": "workspace::ActivatePaneDown",
      "ctrl-w k": "workspace::ActivatePaneUp",
      "ctrl-w l": "workspace::ActivatePaneRight",
      // Explicit return also works when the center editor has no open file.
      "ctrl-w w": "workspace::FocusCenterPane"
    }
  },
  {
    // Yazi-style navigation and file operations in the project panel.
    // Zed's native marked-entry behavior remains on shift-up/shift-down.
    "context": "ProjectPanel && not_editing",
    "bindings": {
      "q": "project_panel::ToggleFocus",
      "h": "project_panel::CollapseSelectedEntry",
      "j": "menu::SelectNext",
      "k": "menu::SelectPrevious",
      "l": "project_panel::ExpandSelectedEntry",
      "g g": "menu::SelectFirst",
      "shift-g": "menu::SelectLast",
      "backspace": "project_panel::SelectParent",

      "enter": "project_panel::OpenPermanent",
      "o": "project_panel::Open",
      "shift-o": "workspace::OpenWithSystem",

      "y": "project_panel::Copy",
      "x": "project_panel::Cut",
      "p": "project_panel::Paste",
      "d": ["project_panel::Trash", { "skip_prompt": false }],
      "shift-d": ["project_panel::Delete", { "skip_prompt": false }],
      "a": "project_panel::NewFile",
      "shift-a": "project_panel::NewDirectory",
      "r": "project_panel::Rename",
      ".": "project_panel::ToggleHideHidden",

      "/": "project_panel::NewSearchInDirectory",
      "c c": "workspace::CopyPath",
      "c r": "workspace::CopyRelativePath",
      "u": "project_panel::Undo",
      "ctrl-r": "project_panel::Redo",
      "ctrl-u": "project_panel::ScrollUp",
      "ctrl-d": "project_panel::ScrollDown"
    }
  }
]
