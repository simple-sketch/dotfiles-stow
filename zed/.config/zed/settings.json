{
  "project_panel": {
    "hide_hidden": false,
  },
  "agent_servers": {
    "codex-acp": {
      "type": "registry",
    },
  },
  // Vim editing, with a small Space-leader keymap in keymap.json.
  "agent": {
    "commit_message_instructions": "Use Conventional Commits format: <type>(<scope>): <description>. Keep the subject imperative, concise, and under 72 characters. Add a short body only when it provides useful context. Return only the commit message, with no quotes or Markdown.",
  },
  "cli_default_open_behavior": "existing_window",
  "vim_mode": true,
  "helix_mode": false,
  "base_keymap": "Zed",
  "vim": {
    "default_mode": "normal",
    "toggle_relative_line_numbers": true,
    "use_system_clipboard": "always",
    "highlight_on_yank_duration": 200,
  },
  "which_key": {
    "enabled": true,
    "delay_ms": 500,
  },

  // Wide picker defaults; preview layouts and resized widths are saved by Zed.
  "file_finder": { "modal_max_width": "xlarge" },
  "call_hierarchy": { "modal_max_width": "xlarge" },

  // Match the quiet editing style of the Vim/Neovim packages.
  // Use Space c f to format on demand; projects can override these defaults.
  "format_on_save": "off",
  "autosave": "off",
  "use_smartcase_search": true,
  "cursor_blink": false,
  "reduce_motion": "on",
  "vertical_scroll_margin": 5,
  "scroll_beyond_last_line": "off",

  // A heavier programming font with Nerd Font symbols.
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "buffer_font_size": 15,
  "buffer_font_weight": 500,
  "buffer_line_height": { "custom": 1.35 },
  "ui_font_size": 15,
  "ui_font_weight": 500,
  "terminal": {
    "font_family": "JetBrainsMono Nerd Font Mono",
    "font_weight": 600,
    "blinking": "off",
  },

  // Keep the local cursor white across themes.
  "experimental.theme_overrides": {
    "players": [{ "cursor": "#FFFFFF" }],
    "vim.helix_jump_label.foreground": "#FFD75F",
  },

  // Built-in theme: no appearance extensions required.
  "theme": "One Dark",
  "colorize_brackets": true,
  "current_line_highlight": "all",
  "indent_guides": {
    "enabled": true,
    "line_width": 1,
    "active_line_width": 2,
    "coloring": "fixed",
    "background_coloring": "disabled",
  },
  "show_whitespaces": "selection",
  "soft_wrap": "bounded",
  "preferred_line_length": 100,
  "minimap": { "show": "never" },
  "toolbar": {
    "breadcrumbs": true,
    "quick_actions": false,
    "selections_menu": false,
  },
  "inlay_hints": { "enabled": false },
  "diagnostics": { "inline": { "enabled": false } },
  "git": { "inline_blame": { "enabled": false } },

  // Language-specific editing and formatting defaults.
  "languages": {
    // Keep JDTLS for Java; Zed supplies indentation and whitespace defaults.
    "Java": { "formatter": "language_server" },
    // Use the default Prettier integration for JS/TS and Ruff for Python.
    "JavaScript": { "tab_size": 2 },
    "TypeScript": { "tab_size": 2 },
    "TSX": { "tab_size": 2 },
  },
}
